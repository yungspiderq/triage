{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.claudemods.triage.TriageMod"
    ],
    "client": [
      "com.claudemods.triage.client.TriageClient"
    ]
  },
  "mixins": [
    "triage.mixins.json",
    {
      "config": "triage.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "triage.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  }
}
